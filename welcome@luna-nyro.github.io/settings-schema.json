{
    "head": { "type": "header", "description": "When to play" },
    "on-login": { "type": "switch", "default": true, "description": "On login (replaces the black startup fade)" },
    "on-unlock": { "type": "switch", "default": true, "description": "When unlocking the screen" },
    "head2": { "type": "header", "description": "Look" },
    "greeting": { "type": "switch", "default": true, "description": "Show greeting, date and time" },
    "speed": { "type": "scale", "default": 1.0, "min": 0.5, "max": 2.0, "step": 0.1, "description": "Speed", "tooltip": "Higher is faster" },
    "intensity": { "type": "scale", "default": 1.0, "min": 0.2, "max": 1.6, "step": 0.1, "description": "Colour motion", "tooltip": "How strongly the gradient swirls" },
    "head3": { "type": "header", "description": "Preview" },
    "btn-unlock": { "type": "button", "description": "Preview unlock", "callback": "preview" },
    "btn-login": { "type": "button", "description": "Preview login", "callback": "previewLogin" }
}
