{
    "general": {
        "type": "header",
        "description": "General"
    },
    "on-login": {
        "type": "switch",
        "default": true,
        "description": "On login (replaces the black startup fade)"
    },
    "on-unlock": {
        "type": "switch",
        "default": true,
        "description": "When unlocking the screen"
    },
    "timing": {
        "type": "header",
        "description": "Timing"
    },
    "login-min": {
        "type": "scale",
        "default": 2.7,
        "description": "Login: shortest duration (seconds)",
        "min": 0.8,
        "max": 8.0,
        "step": 0.1
    },
    "login-max": {
        "type": "scale",
        "default": 3.1,
        "description": "Login: longest duration (seconds)",
        "min": 0.8,
        "max": 8.0,
        "step": 0.1
    },
    "unlock-min": {
        "type": "scale",
        "default": 1.9,
        "description": "Unlock: shortest duration (seconds)",
        "min": 0.8,
        "max": 8.0,
        "step": 0.1
    },
    "unlock-max": {
        "type": "scale",
        "default": 2.2,
        "description": "Unlock: longest duration (seconds)",
        "min": 0.8,
        "max": 8.0,
        "step": 0.1
    },
    "speed": {
        "type": "scale",
        "default": 1.0,
        "min": 0.5,
        "max": 2.0,
        "step": 0.1,
        "description": "Speed",
        "tooltip": "Higher is faster"
    },
    "lock": {
        "type": "header",
        "description": "Lock screen"
    },
    "lock-loop": {
        "type": "combobox",
        "default": "prompt",
        "description": "Animate the lock screen",
        "options": {
            "With the password prompt": "prompt",
            "Always": "always",
            "Never": "off"
        }
    },
    "lock-speed": {
        "type": "scale",
        "default": 0.6,
        "min": 0.1,
        "max": 1.5,
        "step": 0.05,
        "description": "Lock screen: loop speed",
        "tooltip": "One loop lasts 24 s at speed 1"
    },
    "lock-intensity": {
        "type": "scale",
        "default": 0.55,
        "min": 0.1,
        "max": 1.2,
        "step": 0.05,
        "description": "Lock screen: motion strength"
    },
    "lock-shade": {
        "type": "scale",
        "default": 50,
        "min": 30,
        "max": 70,
        "step": 1,
        "description": "Lock screen: wallpaper dimming (%)",
        "tooltip": "How dark the wallpaper is behind the lock screen while it moves. The screensaver's own is 70%."
    },
    "unlock-boost": {
        "type": "scale",
        "default": 2.5,
        "min": 1.0,
        "max": 5.0,
        "step": 0.1,
        "description": "Unlock: speed-up into the desktop",
        "tooltip": "How much faster the loop runs once the password is accepted"
    },
    "unlock-surge": {
        "type": "scale",
        "default": 1.3,
        "min": 0.5,
        "max": 2.0,
        "step": 0.05,
        "description": "Unlock: extra motion into the desktop"
    },
    "desktop": {
        "type": "header",
        "description": "Desktop"
    },
    "desktop-loop": {
        "type": "switch",
        "default": false,
        "description": "Keep the wallpaper moving on the desktop",
        "tooltip": "Only while enough of the desktop is visible"
    },
    "desktop-speed": {
        "type": "scale",
        "default": 0.35,
        "min": 0.1,
        "max": 1.5,
        "step": 0.05,
        "description": "Desktop: loop speed",
        "dependency": "desktop-loop"
    },
    "desktop-intensity": {
        "type": "scale",
        "default": 0.35,
        "min": 0.1,
        "max": 1.0,
        "step": 0.05,
        "description": "Desktop: motion strength",
        "dependency": "desktop-loop"
    },
    "desktop-min-visible": {
        "type": "scale",
        "default": 15,
        "min": 1,
        "max": 60,
        "step": 1,
        "description": "Desktop: play when at least this much is uncovered (%)",
        "dependency": "desktop-loop"
    },
    "desktop-fps": {
        "type": "combobox",
        "default": 30,
        "description": "Desktop: frame rate",
        "options": {
            "30 fps (saves power)": 30,
            "60 fps (smoother)": 60
        },
        "dependency": "desktop-loop"
    },
    "desktop-battery": {
        "type": "switch",
        "default": false,
        "description": "Desktop: pause on battery power",
        "dependency": "desktop-loop"
    },
    "motion": {
        "type": "header",
        "description": "Motion"
    },
    "motion-pattern": {
        "type": "combobox",
        "default": "swirl",
        "description": "Motion pattern",
        "options": {
            "Swirl": "swirl",
            "Waves": "waves",
            "Aurora": "aurora",
            "Ripple": "ripple"
        }
    },
    "intensity": {
        "type": "scale",
        "default": 1.0,
        "min": 0.2,
        "max": 1.6,
        "step": 0.1,
        "description": "Colour motion",
        "tooltip": "How strongly the gradient swirls"
    },
    "hue-strength": {
        "type": "scale",
        "default": 1.0,
        "description": "Colour drift",
        "min": 0.0,
        "max": 2.0,
        "step": 0.1
    },
    "sweep-strength": {
        "type": "scale",
        "default": 1.0,
        "description": "Light sweep",
        "min": 0.0,
        "max": 2.0,
        "step": 0.1
    },
    "randomness": {
        "type": "scale",
        "default": 1.0,
        "description": "Variation each time",
        "min": 0.0,
        "max": 1.0,
        "step": 0.05
    },
    "reveal": {
        "type": "header",
        "description": "Reveal"
    },
    "reveal-pattern": {
        "type": "combobox",
        "default": "bloom",
        "description": "Reveal pattern",
        "options": {
            "Bloom": "bloom",
            "Horizontal wipe": "horizontal",
            "Vertical wipe": "vertical",
            "Soft dissolve": "dissolve"
        }
    },
    "edge-softness": {
        "type": "scale",
        "default": 1.0,
        "description": "Reveal edge softness",
        "min": 0.3,
        "max": 2.0,
        "step": 0.1
    },
    "glow-strength": {
        "type": "scale",
        "default": 1.0,
        "description": "Reveal glow",
        "min": 0.0,
        "max": 2.0,
        "step": 0.1
    },
    "greeting-options": {
        "type": "header",
        "description": "Greeting"
    },
    "greeting": {
        "type": "switch",
        "default": true,
        "description": "Show greeting, date and time"
    },
    "show-date": {
        "type": "switch",
        "default": true,
        "description": "Show date and time"
    },
    "custom-greeting": {
        "type": "entry",
        "default": "",
        "description": "Custom greeting (optional)"
    },
    "preview": {
        "type": "header",
        "description": "Preview"
    },
    "btn-unlock": {
        "type": "button",
        "description": "Preview unlock",
        "callback": "preview"
    },
    "btn-login": {
        "type": "button",
        "description": "Preview login",
        "callback": "previewLogin"
    },
    "btn-lock": {
        "type": "button",
        "description": "Preview lock screen loop",
        "callback": "previewLock"
    }
}
